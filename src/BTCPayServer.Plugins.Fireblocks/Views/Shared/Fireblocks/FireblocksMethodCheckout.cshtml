@model BTCPayServer.Models.InvoicingModels.CheckoutModel
@using BTCPayServer.Plugins.Fireblocks.Payments

<template id="@FireblocksCheckoutModelExtension.CheckoutBodyComponentName">
    <div class="payment-box">
        <p class="text-muted">
            Pay this USD invoice through Fireblocks Flow. The merchant receives USDC on Solana.
        </p>
        <a v-if="flowPaymentUrl" class="btn btn-primary rounded-pill w-100 mt-3" id="PayWithFireblocksFlow"
           :href="flowPaymentUrl" target="_blank" rel="noopener noreferrer">
            Open hosted Flow payment
        </a>
        <p v-else class="alert alert-warning mt-3">
            This Flow link is no longer valid for the invoice. Do not pay an outdated link; a new attempt requires verified terminal-state reconciliation.
        </p>
        <div class="input-group mt-3" v-if="flowPaymentUrl">
            <div class="form-floating">
                <vc:truncate-center text="flowPaymentUrl" is-vue="true" padding="15" elastic="true" classes="form-control-plaintext" />
                <label>Hosted payment link</label>
            </div>
        </div>
        <p class="text-muted small mt-3 mb-0">
            Opening this link or returning to BTCPay does not confirm payment or change the invoice state.
        </p>
    </div>
</template>

<script>
    Vue.component(@Safe.Json(FireblocksCheckoutModelExtension.CheckoutBodyComponentName), {
        props: ['model'],
        template: @Safe.Json("#" + FireblocksCheckoutModelExtension.CheckoutBodyComponentName),
        data () {
            return { flowExpired: false, flowExpiryTimer: null };
        },
        computed: {
            flowPaymentUrl () {
                return this.flowExpired ? null : this.model.fireblocksPaymentUrl;
            }
        },
        methods: {
            updateFlowExpiry () {
                const deadline = Number(this.model.fireblocksExpiresAt || 0) * 1000;
                this.flowExpired = deadline > 0 && Date.now() >= deadline;
            }
        },
        mounted () {
            this.updateFlowExpiry();
            this.flowExpiryTimer = setInterval(this.updateFlowExpiry, 1000);
        },
        beforeDestroy () {
            clearInterval(this.flowExpiryTimer);
        }
    });
</script>
