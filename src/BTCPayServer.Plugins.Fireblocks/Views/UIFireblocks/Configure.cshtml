@model BTCPayServer.Plugins.Fireblocks.Controllers.FireblocksStoreConfigViewModel
@{
    ViewData.SetLayoutModel(new LayoutModel("Fireblocks", "Fireblocks Flow").SetCategory(WellKnownCategories.Store));
    Layout = "_Layout";
}

<h2 class="mb-4">Core Fireblocks API</h2>
<p>Workspace connection, separate from Dynamic Flow. Test connection is read-only. Sandbox does not enable testnet checkout.</p>
<form method="post" asp-action="ConfigureCore" asp-route-storeId="@Context.Request.RouteValues["storeId"]" autocomplete="off">
    <div class="form-group">
        <label asp-for="CoreApi.Environment" class="form-label">Workspace environment</label>
        <select asp-for="CoreApi.Environment" class="form-select">
            <option value="Sandbox">Sandbox — https://sandbox-api.fireblocks.io/v1</option>
            <option value="US">US Mainnet/Testnet — https://api.fireblocks.io/v1</option>
        </select>
        <span asp-validation-for="CoreApi.Environment" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="CoreApi.ApiKey" class="form-label">Core workspace API key</label>
        <input asp-for="CoreApi.ApiKey" type="password" class="form-control" autocomplete="new-password"
               placeholder="@(Model.HasCoreApiKey ? "Leave blank to keep the saved key" : "Workspace API key")" />
        <span asp-validation-for="CoreApi.ApiKey" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="CoreApi.PrivateKey" class="form-label">RSA private key (PEM, write-only)</label>
        <textarea asp-for="CoreApi.PrivateKey" class="form-control" rows="3" autocomplete="new-password"
                  placeholder="@(Model.HasCorePrivateKey ? "Leave blank to keep the saved private key" : "Unencrypted RSA private key PEM")"></textarea>
        <span asp-validation-for="CoreApi.PrivateKey" class="text-danger"></span>
        <div class="form-text">Secrets are stored in server-side store configuration, not a secret manager. Protect the database and backups. Blank secrets retain saved values; replace both credentials when switching workspaces.</div>
    </div>
    <button type="submit" name="command" value="save" class="btn btn-primary">Save core settings</button>
    <button type="submit" name="command" value="test" class="btn btn-secondary">Test connection</button>
    <p class="form-text">Test uses the entered credentials (or saved values when blank), without saving them or moving funds.</p>
</form>

<h2 class="mb-4 mt-4">Collection vault</h2>
<p>Create vault and use address with the saved core workspace credentials. Creation never changes credentials or the existing destination. Only mainnet USDC can be applied to Dynamic checkout; test assets remain separate.</p>
@if (Model.VaultMessage is not null)
{
    <p class="text-warning">@Model.VaultMessage</p>
}
<form method="post" asp-action="ConfigureVault" asp-route-storeId="@Context.Request.RouteValues["storeId"]">
    @if (Model.Vault is null)
    {
        <label for="vault-asset" class="form-label">Supported Solana asset</label>
        <select id="vault-asset" name="assetId" class="form-select">
            @foreach (var asset in Model.VaultAssets)
            {
                <option value="@asset">@asset — @(asset == "USDC_SOL" ? "Mainnet USDC" : "NON-PRODUCTION / test asset")</option>
            }
        </select>
        <button type="submit" name="command" value="create" class="btn btn-secondary mt-2" disabled="@(Model.VaultAssets.Count == 0)">Create vault and use address</button>
        <p class="form-text">Creates one collection vault. When ready, confirm Use address below to replace the destination. No automatic SOL fueling or sweeps.</p>
    }
    else
    {
        <p><strong>@Model.Vault.State — @(Model.Vault.ProductionCompatible ? "Mainnet USDC" : "NON-PRODUCTION / Sandbox or test asset")</strong></p>
        <p>@Model.Vault.Diagnostic</p>
        <p>Workspace: @Model.Vault.Environment · Asset: @Model.Vault.AssetId · Vault: @Model.Vault.VaultAccountId</p>
        <p>Address: <code>@Model.Vault.Address</code></p>
        <button type="submit" name="command" value="refresh" class="btn btn-secondary">Refresh status / retry</button>
        @if (Model.Vault.ActivationFailed || Model.Vault.ActivationRequired)
        {
            <button type="submit" name="command" value="activate" class="btn btn-warning">Retry activation (may spend SOL)</button>
        }
        @if (Model.Vault.State == "Success" && Model.Vault.ProductionCompatible)
        {
            <button type="submit" name="command" value="use" class="btn btn-primary">Use address (replace saved destination)</button>
        }
    }
</form>

@if (Model.Vault is not null)
{
    <h2 class="mb-4 mt-4">Vault sweeps</h2>
    <p>One same-asset transfer on @Model.Vault.AssetId / @Model.Vault.Environment. Verify the destination belongs to this network: Solana addresses do not identify their network. Fees may require native SOL. No automatic fueling, signing or approvals.</p>
    <form method="post" asp-action="Sweep" asp-route-storeId="@Context.Request.RouteValues["storeId"]">
        <label for="sweep-destination" class="form-label">Saved sweep wallet destination</label>
        <input id="sweep-destination" name="destination" value="@Model.Sweeps.Destination" class="form-control" autocomplete="off" />
        <button type="submit" name="command" value="save" class="btn btn-secondary mt-2">Save sweep destination</button>
        <button type="submit" name="command" value="prepare" class="btn btn-warning mt-2" disabled="@(Model.Vault.State != "Success" || Model.Sweeps.Records.Any(r => r.Unresolved))">Sweep now</button>
        <p class="form-text">Sweep now uses the saved destination, not unsaved edits. You will review and confirm before submission.</p>
        <button type="submit" name="command" value="refresh" class="btn btn-secondary">Refresh sweep status</button>
    </form>
    <form method="post" asp-action="Sweep" asp-route-storeId="@Context.Request.RouteValues["storeId"]" class="mt-3">
        <div class="form-check">
            <input id="sweep-automation" name="automationEnabled" type="checkbox" value="true" checked="@Model.Sweeps.AutomationEnabled" class="form-check-input" />
            <label for="sweep-automation" class="form-check-label">Enable automatic full-available-balance sweeps (may spend funds without per-transfer confirmation)</label>
        </div>
        <label for="sweep-interval" class="form-label">Check interval (minutes, 1–525600)</label>
        <input id="sweep-interval" name="checkIntervalMinutes" type="number" min="1" max="525600" value="@Model.Sweeps.CheckIntervalMinutes" class="form-control" />
        <label for="sweep-minimum" class="form-label">Minimum available balance (@Model.Vault.AssetId)</label>
        <input id="sweep-minimum" name="minimumAvailableBalance" value="@Model.Sweeps.MinimumAvailableBalance" class="form-control" />
        <button type="submit" name="command" value="automation" class="btn btn-warning mt-2">Save automation settings</button>
        <p class="form-text">Off by default. Uses only the saved destination above; changing it disables automation. The minimum is a trigger, not a spending cap. Fees may cause full-balance sweeps to fail. Policy, approvals and signing remain in Fireblocks.</p>
    </form>
    <p>Last automatic check: @Model.Sweeps.LastCheckAt · @Model.Sweeps.CheckDiagnostic</p>
    <p>Last submission attempt: @Model.Sweeps.Records.Where(r => r.SubmittedAt != null).OrderByDescending(r => r.SubmittedAt).FirstOrDefault()?.SubmittedAt</p>
    @foreach (var sweep in Model.Sweeps.Records.Where(r => r.State != "Expired" && r.State != "Confirmation").OrderByDescending(r => r.CreatedAt))
    {
        <div class="border rounded p-3 mt-2">
            <strong>@(sweep.Automatic ? "Automatic" : "Manual") · @sweep.State · @sweep.ProviderStatus</strong>
            <p>@sweep.CreatedAt · @sweep.Amount @sweep.AssetId · @sweep.Environment · Vault @sweep.VaultId → <code>@sweep.Destination</code></p>
            <p>@sweep.Diagnostic</p>
            <p>Fireblocks transaction: <code>@sweep.TransactionId</code> · External ID: <code>@sweep.Id</code></p>
        </div>
    }
}

<h2 class="mb-4 mt-4">Fireblocks Flow</h2>
<p class="text-muted mb-4">
    Create hosted Dynamic Flow payment links for USD invoices. Settlement is fixed to USDC on Solana.
    Invoices are credited only after authenticated notification or periodic reconciliation confirms completed settlement and acceptable risk.
</p>

<form method="post" asp-action="Configure" asp-route-storeId="@Context.Request.RouteValues["storeId"]">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-check form-switch mb-4">
        <input asp-for="Enabled" class="form-check-input" />
        <label asp-for="Enabled" class="form-check-label">Enable Fireblocks Flow at checkout</label>
    </div>
    <div class="form-group">
        <label asp-for="EnvironmentId" class="form-label" data-required></label>
        <input asp-for="EnvironmentId" class="form-control" autocomplete="off" />
        <span asp-validation-for="EnvironmentId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="ApiEndpoint" class="form-label" data-required></label>
        <input asp-for="ApiEndpoint" class="form-control" />
        <div class="form-text">Use HTTPS in production. Plain HTTP is accepted only for the local fake provider.</div>
        <span asp-validation-for="ApiEndpoint" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="ApiCredential" class="form-label" data-required="@(!Model.HasApiCredential)"></label>
        <input asp-for="ApiCredential" type="password" class="form-control" autocomplete="new-password"
               placeholder="@(Model.HasApiCredential ? "Leave blank to keep the saved token" : "Token with payment-link creation and Flow read access")" />
        <div class="form-text">Stored only in server-side store configuration and never returned to the browser or Greenfield responses.</div>
        <span asp-validation-for="ApiCredential" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="WebhookSecret" class="form-label" data-required="@(!Model.HasWebhookSecret)"></label>
        <input asp-for="WebhookSecret" type="password" class="form-control" autocomplete="new-password"
               placeholder="@(Model.HasWebhookSecret ? "Leave blank to keep the saved secret" : "Dynamic webhook signing secret")" />
        <div class="form-text">Configure Dynamic to POST flow.execution.updated, flow.settlement.updated, and flow.risk.updated to <code>/stores/&lt;store-id&gt;/fireblocks/webhook</code>. The secret is never returned to browsers or API responses.</div>
        <span asp-validation-for="WebhookSecret" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="AcceptedRiskStates" class="form-label" data-required></label>
        <input asp-for="AcceptedRiskStates" class="form-control" autocomplete="off" />
        <div class="form-text">The default is <code>cleared</code>. Accounting always requires the exact provider state <code>cleared</code> and this policy must include it. Adding unknown, blocked, pending, or review states cannot authorize settlement. Cleared does not prove screening for exchange or deposit-address sources.</div>
        <span asp-validation-for="AcceptedRiskStates" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="HostedPaymentBaseUrl" class="form-label" data-required></label>
        <input asp-for="HostedPaymentBaseUrl" class="form-control" />
        <div class="form-text">Use https://pay.dynamicauth.com for Dynamic's hosted page; its origin must be registered for the environment.</div>
        <span asp-validation-for="HostedPaymentBaseUrl" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="SolanaDestinationAddress" class="form-label" data-required></label>
        <input asp-for="SolanaDestinationAddress" class="form-control" autocomplete="off" />
        <div class="form-text">One base58 Solana address. The USDC mint and Solana mainnet chain identifiers are fixed by the plugin.</div>
        <span asp-validation-for="SolanaDestinationAddress" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="PaymentExpiryMinutes" class="form-label" data-required></label>
        <input asp-for="PaymentExpiryMinutes" class="form-control" min="1" max="525600" />
        <div class="form-text">Uses the earlier policy and current invoice deadline. Avoid concurrent edits to invoice expiry while activating a payment.</div>
        <span asp-validation-for="PaymentExpiryMinutes" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary mt-4">Save settings</button>
</form>
